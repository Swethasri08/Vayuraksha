{
  "expo": {
    "name": "VayuRaksha",
    "slug": "vayuraksha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#040B1C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.vayuraksha.app"
    },
    "android": {
      "package": "in.vayuraksha.app",
      "adaptiveIcon": {
        "backgroundColor": "#040B1C"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
